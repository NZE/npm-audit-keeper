{
  "name": "npm-audit-keeper",
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "npm audit CI gate with GHSA-based exceptions and expiry dates",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NZE/npm-audit-keeper.git"
  },
  "homepage": "https://github.com/NZE/npm-audit-keeper#readme",
  "bugs": "https://github.com/NZE/npm-audit-keeper/issues",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "audit-check": "dist/index.js",
    "audit-keeper": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CONTRIBUTING.md",
    "RELEASING.md"
  ],
  "scripts": {
    "build": "node ./scripts/build.cjs",
    "demo": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/demo.ps1",
    "test": "npm run build && vitest run --pool=threads --globals",
    "test:package": "node ./scripts/test-package.cjs",
    "audit": "node ./dist/index.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
